{
  "name": "charge-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready Bangladesh financial charge calculator for bKash, Nagad, Nagad Islamic, Send Money, ATM, and NPSB transfers.",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./scripts/build.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host",
    "test": "node ./scripts/test.mjs",
    "test:watch": "node ./scripts/test.mjs --watch",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "lint": "node ./node_modules/eslint/bin/eslint.js src"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.13.0",
    "postcss": "^8.4.49",
    "rollup": "npm:@rollup/wasm-node@^4.24.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.24.0"
  }
}
